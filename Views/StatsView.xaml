<UserControl x:Class="ShiJi.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShiJi.Controls"
             Background="Transparent">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,30">
            <Grid>
                <StackPanel>
                    <TextBlock Text="统计" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="按时间段查看总时长、应用分布和最常使用的应用。" Margin="0,7,0,0"
                               Style="{StaticResource SubText}" Visibility="Collapsed" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="White"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="统计视图" FontSize="11.5" Margin="7,0,0,0"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#F0F1F6" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PeriodDay" Style="{StaticResource SegmentRadio}" GroupName="StatsPeriod"
                                         Content="按天" Tag="day" IsChecked="True" Checked="Period_Checked" />
                            <RadioButton x:Name="PeriodWeek" Style="{StaticResource SegmentRadio}" GroupName="StatsPeriod"
                                         Content="按周" Tag="week" Checked="Period_Checked" />
                            <RadioButton x:Name="PeriodMonth" Style="{StaticResource SegmentRadio}" GroupName="StatsPeriod"
                                         Content="按月" Tag="month" Checked="Period_Checked" />
                            <RadioButton x:Name="PeriodYear" Style="{StaticResource SegmentRadio}" GroupName="StatsPeriod"
                                         Content="按年" Tag="year" Checked="Period_Checked" />
                        </StackPanel>
                    </Border>
                    <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Margin="10,0,0,0" Click="Previous_Click" ToolTip="上一时间段" />
                    <TextBlock x:Name="PeriodRangeText" Text="" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                               Margin="8,0,8,0" VerticalAlignment="Center" MinWidth="140" />
                    <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Click="Next_Click" ToolTip="下一时间段" />
                    <Button Content="今天" Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0"
                            Click="Today_Click" />
                </StackPanel>
                <TextBlock x:Name="FilterSummaryText" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <UniformGrid Columns="3" Margin="0,10,0,0">
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,6,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="总时长" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="TotalValue" Text="0秒" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TotalSub" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,6,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#E9F2FF" VerticalAlignment="Top">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="#017AFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="应用量" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="AppCountValue" Text="0" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" />
                            <TextBlock x:Name="AppCountSub" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FFF3E4" VerticalAlignment="Top">
                            <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="#D97A17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="最长使用" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="LongestValue" Text="—" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="LongestSub" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20" Margin="0,6,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="ChartTitle" Text="运行分布" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ChartSubtitle" Text="" Style="{StaticResource CaptionText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ChartTotalText" Text="" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <controls:StackedBarChart x:Name="Chart" Height="255" Margin="0,12,0,0" />
                        <WrapPanel x:Name="ChartLegend" Margin="2,8,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="应用雷达" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="使用时长前 5 个应用" Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0" />
                            <controls:AppRadarChart x:Name="Radar" Height="245" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="最常使用" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="MostUsedCountText" Text="Top 5" FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel x:Name="MostUsedPanel" Margin="0,8,0,0" />
                            <TextBlock x:Name="MostUsedEmpty" Text="这个时间段还没有记录" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

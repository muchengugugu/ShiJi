<UserControl x:Class="ShiJi.Views.AppDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShiJi.Controls"
             Background="Transparent">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,24,34,30">
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,4"
                    AutomationProperties.Name="返回详细" Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="返回详细" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Grid Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="AppBadgeHost" Width="58" Height="58" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" Text="" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="AppPathText" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RenameAppButton" Content="重命名" Style="{StaticResource SecondaryButton}"
                            Padding="12,7" Margin="0,0,10,0" Click="RenameApp_Click" />
                    <Button Content="删除全部记录" Style="{StaticResource DangerButton}" Padding="12,7"
                            VerticalAlignment="Center" Click="DeleteAll_Click" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#F0F1F6" CornerRadius="10" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PeriodDay" Style="{StaticResource SegmentRadio}" GroupName="AppPeriod"
                                                 Content="按天" Tag="day" IsChecked="True" Checked="Period_Checked" />
                                    <RadioButton x:Name="PeriodWeek" Style="{StaticResource SegmentRadio}" GroupName="AppPeriod"
                                                 Content="按周" Tag="week" Checked="Period_Checked" />
                                    <RadioButton x:Name="PeriodMonth" Style="{StaticResource SegmentRadio}" GroupName="AppPeriod"
                                                 Content="按月" Tag="month" Checked="Period_Checked" />
                                    <RadioButton x:Name="PeriodYear" Style="{StaticResource SegmentRadio}" GroupName="AppPeriod"
                                                 Content="按年" Tag="year" Checked="Period_Checked" />
                                </StackPanel>
                            </Border>
                            <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Margin="10,0,0,0" Click="Previous_Click" ToolTip="上一时间段" />
                            <TextBlock x:Name="PeriodRangeText" Text="" FontSize="11.5"
                                       Foreground="{StaticResource SubTextBrush}" Margin="8,0,8,0"
                                       VerticalAlignment="Center" MinWidth="150" />
                            <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Click="Next_Click" ToolTip="下一时间段" />
                            <Button Content="今天" Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0"
                                    Click="Today_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="总计时长" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalValue" Text="0秒" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="9,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ChartTitle" Text="每小时运行分布" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,18,0,0" />
                    <TextBlock x:Name="ChartSubtitle" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0" />
                    <controls:StackedBarChart x:Name="Chart" Height="230" Margin="0,10,0,0" />
                    <TextBlock x:Name="EmptyChartText" Text="这个时间段还没有运行记录" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="月度总览" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="按天查看这个应用在本月的使用分布。" Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Click="MonthPrevious_Click" ToolTip="上一个月" />
                            <TextBlock x:Name="MonthTitle" Text="" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="9,0,9,0"
                                       VerticalAlignment="Center" MinWidth="90" TextAlignment="Center" />
                            <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Click="MonthNext_Click" ToolTip="下一个月" />
                            <Button Content="清空该月统计" Style="{StaticResource DangerButton}" Padding="11,6"
                                    Margin="12,0,0,0" Click="ClearMonth_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FCFCFE" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel>
                                <UniformGrid Columns="7" Margin="0,0,0,5">
                                    <TextBlock Text="一" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="二" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="三" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="四" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="五" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="六" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="日" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                </UniformGrid>
                                <UniformGrid x:Name="CalendarGrid" Columns="7" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="#F7F6FF" CornerRadius="11" Padding="13,11">
                                <StackPanel>
                                    <TextBlock Text="该月累计使用" FontSize="10.5" Foreground="#8C86A8" />
                                    <TextBlock x:Name="MonthTotalText" Text="0秒" FontSize="18" FontWeight="SemiBold"
                                               Foreground="#3F3767" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F7F9FC" CornerRadius="11" Padding="13,11" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="最长一天" FontSize="10.5" Foreground="#8C92A0" />
                                    <TextBlock x:Name="LongestDayText" Text="—" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#394052" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LongestDaySub" Text="" FontSize="10" Foreground="#9A9CAB"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F7F9FC" CornerRadius="11" Padding="13,11" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="占当月所有应用时长" FontSize="10.5" Foreground="#8C92A0" />
                                    <TextBlock x:Name="ShareText" Text="0%" FontSize="18" FontWeight="SemiBold"
                                               Foreground="#394052" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

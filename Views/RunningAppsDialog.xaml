<Window x:Class="ShiJi.Views.RunningAppsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从运行中的程序添加" Width="790" Height="720" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Icon="/Assets/app.ico">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="从运行中的程序添加" FontSize="21" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="勾选正在运行的程序；读取不到路径的游戏会按进程名加入。"
                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Padding="12,7" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="刷新" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" BorderBrush="#E1E2EC" BorderThickness="1" CornerRadius="9"
                            Width="290" Height="36">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Margin="31,0,10,0"
                                     VerticalContentAlignment="Center" FontSize="12" TextChanged="SearchBox_TextChanged"
                                     CaretBrush="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="SearchHint" Text="搜索程序名或路径（含后台）" FontSize="11.5" Foreground="#A6A8B7"
                                       Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <CheckBox x:Name="ShowBackground" Style="{StaticResource ToggleSwitch}" Margin="18,0,0,0"
                              VerticalAlignment="Center" Checked="ShowBackground_Changed" Unchecked="ShowBackground_Changed" />
                    <TextBlock Text="显示后台进程" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="HiddenCountText" Text="" FontSize="10" Foreground="{StaticResource MutedBrush}"
                               Margin="7,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TotalCountText" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,84,0" />
                <CheckBox x:Name="SelectAllBox" Style="{StaticResource CheckSquare}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Click="SelectAll_Click" />
                <TextBlock Text="全选" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#FCFCFE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <TextBlock Text="程序" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="实例" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,118,0" />
                        <TextBlock Text="状态" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,42,0" />
                    </Grid>
                </Border>
                <ListBox x:Name="ProcessList" Grid.Row="1" ItemContainerStyle="{StaticResource PlainListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F4F4F8" BorderThickness="0,0,0,1">
                                <Grid Height="58" Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource CheckSquare}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="9"
                                            Background="{Binding BadgeBackground}" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PathDisplay}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding PathDisplay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="4" Background="{Binding StateBackground}" CornerRadius="16"
                                            Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}" FontSize="9.5" Foreground="{Binding StateForeground}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="LoadingPanel" Grid.Row="1" Background="White">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="正在读取运行中的程序…" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="NoResultPanel" Grid.Row="1" Background="White" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="#D5D6E0" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NoResultText" Text="没有可添加的程序" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedCountText" Text="已选择 0 个" FontSize="11.5"
                           Foreground="{StaticResource SubTextBrush}" />
                <TextBlock Text="· 受保护进程无法读取路径时，将按进程名匹配" FontSize="10.5"
                           Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="84" Padding="0,8"
                        Click="Cancel_Click" />
                <Button x:Name="AddButton" Content="加入名单" Style="{StaticResource PrimaryButton}" Width="100"
                        Padding="0,8" Margin="10,0,0,0" Click="Add_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

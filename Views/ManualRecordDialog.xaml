<Window x:Class="ShiJi.Views.ManualRecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加记录" Width="430" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Icon="/Assets/app.ico">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="添加启动记录" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="DayText" Text="" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel x:Name="AppPickerPanel" Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="应用" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
            <ComboBox x:Name="AppCombo" Height="34" Margin="0,7,0,0"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="Input_Changed" />
        </StackPanel>

        <StackPanel x:Name="FixedAppPanel" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
            <TextBlock Text="应用" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="11,9" Margin="0,7,0,0">
                <TextBlock x:Name="FixedAppText" Text="" FontSize="12"
                           Foreground="{StaticResource TextBrush}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="开始时间" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <ComboBox x:Name="StartHourCombo" Width="78" Height="34"
                              SelectionChanged="Input_Changed" />
                    <TextBlock Text=":" FontSize="14" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="5,0" />
                    <ComboBox x:Name="StartMinuteCombo" Width="78" Height="34"
                              SelectionChanged="Input_Changed" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="时长" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <ComboBox x:Name="DurationHourCombo" Width="78" Height="34"
                              SelectionChanged="Input_Changed" />
                    <TextBlock Text="时" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="5,0" />
                    <ComboBox x:Name="DurationMinuteCombo" Width="78" Height="34"
                              SelectionChanged="Input_Changed" />
                    <TextBlock Text="分" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="5,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="#F7F6FF" CornerRadius="9" Padding="12,9" Margin="0,18,0,0">
            <TextBlock x:Name="EndPreviewText" Text="" FontSize="11"
                       Foreground="#5F54A2" />
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="82" Padding="0,8"
                    Click="Cancel_Click" />
            <Button Content="添加" Style="{StaticResource PrimaryButton}" Width="82" Padding="0,8"
                    Margin="10,0,0,0" Click="Add_Click" />
        </StackPanel>
    </Grid>
</Window>

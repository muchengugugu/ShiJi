<UserControl x:Class="ShiJi.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,30">
            <Grid>
                <StackPanel>
                    <TextBlock Text="启动统计" Style="{StaticResource PageTitle}" />
                </StackPanel>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TodayText" Text="" FontSize="11.5" Margin="7,0,0,0"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Columns="4" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Padding="17" Margin="0,6,12,0">
                    <StackPanel>
                        <TextBlock Text="今天已启动" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="TodayLaunchedValue" Text="0 / 0" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                        <TextBlock x:Name="TodayLaunchedSub" Text="名单内应用" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="17" Margin="0,6,12,0">
                    <StackPanel>
                        <TextBlock Text="今日启动次数" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="TodayLaunchCountValue" Text="0 次" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                        <TextBlock x:Name="TodayLaunchCountSub" Text="按进程启动计" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="17" Margin="0,6,12,0">
                    <StackPanel>
                        <TextBlock x:Name="RangeLaunchLabel" Text="近 14 天启动" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="RangeLaunchValue" Text="0 次" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                        <TextBlock x:Name="RangeLaunchSub" Text="覆盖 0 天" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="17" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="统计范围运行" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="RangeDurationValue" Text="0秒" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RangeDurationSub" Text="所有应用合计" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Padding="20,18,20,14" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="今日启动" Style="{StaticResource CardTitle}" />
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="20" Padding="8,3"
                                        Margin="8,0,0,0">
                                    <TextBlock x:Name="TodayRatioText" Text="0 / 0" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="TodayAddButton" Content="&#xE710;" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" Click="AddApp_Click" ToolTip="添加应用" />
                    </Grid>
                    <WrapPanel x:Name="TodayPanel" Margin="0,9,0,0" />
                    <Border x:Name="TodayEmpty" Visibility="Collapsed" Padding="0,20,0,22">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="#D5D6E0" HorizontalAlignment="Center" />
                            <TextBlock Text="名单还没有应用，添加后这里会逐项显示今天的启动状态。"
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <Button Content="添加应用" Style="{StaticResource PrimaryButton}" Padding="14,7"
                                    Margin="0,13,0,0" Click="AddApp_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,17,20,14" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="每日启动矩阵" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#F0F1F6" CornerRadius="9" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Range14" Style="{StaticResource SegmentRadio}" GroupName="CalendarRange"
                                                 Content="近 14 天" Tag="14" IsChecked="True" Checked="Range_Checked" />
                                    <RadioButton x:Name="Range30" Style="{StaticResource SegmentRadio}" GroupName="CalendarRange"
                                                 Content="近 30 天" Tag="30" Checked="Range_Checked" />
                                    <RadioButton x:Name="RangeMonth" Style="{StaticResource SegmentRadio}" GroupName="CalendarRange"
                                                 Content="本月" Tag="month" Checked="Range_Checked" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="MatrixScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0"
                                  HorizontalContentAlignment="Left"
                                  PanningMode="HorizontalOnly"
                                  PreviewMouseWheel="MatrixScroll_PreviewMouseWheel">
                        <Grid x:Name="MatrixGrid" />
                    </ScrollViewer>

                    <Grid Margin="0,9,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="少" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <Border Width="14" Height="14" CornerRadius="4" Background="#F3F3F8" Margin="6,0,3,0" />
                            <Border Width="14" Height="14" CornerRadius="4" Background="#E6E1FF" Margin="0,0,3,0" />
                            <Border Width="14" Height="14" CornerRadius="4" Background="#C8BBFF" Margin="0,0,3,0" />
                            <Border Width="14" Height="14" CornerRadius="4" Background="#9B86F2" Margin="0,0,3,0" />
                            <Border Width="14" Height="14" CornerRadius="4" Background="#6A5AE0" />
                            <TextBlock Text="多" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="3,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="点击任意格子，查看当天的启动明细" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="DetailCard" Style="{StaticResource Card}" Padding="20,17,20,14" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle" Text="启动明细" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="DetailSubtitle" Text="" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="DetailResetButton" Content="查看今日" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="DetailReset_Click" />
                    </Grid>
                    <StackPanel x:Name="DetailPanel" Margin="0,8,0,0" />
                    <Border x:Name="DetailEmpty" Visibility="Collapsed" Padding="0,20,0,22">
                        <TextBlock x:Name="DetailEmptyText" Text="这一天没有符合条件的启动记录。"
                                   FontSize="11.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

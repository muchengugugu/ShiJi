<UserControl x:Class="ShiJi.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,30">
            <Grid>
                <StackPanel>
                    <TextBlock Text="详细" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="按时间范围汇总每个应用的使用时长，点击应用进入详细画面。" Margin="0,7,0,0"
                               Style="{StaticResource SubText}" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="PeriodLabel" Text="" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#F0F1F6" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PeriodDay" Style="{StaticResource SegmentRadio}" GroupName="DetailPeriod"
                                         Content="按天" Tag="day" IsChecked="True" Checked="Period_Checked" />
                            <RadioButton x:Name="PeriodWeek" Style="{StaticResource SegmentRadio}" GroupName="DetailPeriod"
                                         Content="按周" Tag="week" Checked="Period_Checked" />
                            <RadioButton x:Name="PeriodMonth" Style="{StaticResource SegmentRadio}" GroupName="DetailPeriod"
                                         Content="按月" Tag="month" Checked="Period_Checked" />
                            <RadioButton x:Name="PeriodYear" Style="{StaticResource SegmentRadio}" GroupName="DetailPeriod"
                                         Content="按年" Tag="year" Checked="Period_Checked" />
                        </StackPanel>
                    </Border>
                    <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Margin="10,0,0,0" Click="Previous_Click" ToolTip="上一时间段" />
                    <TextBlock x:Name="RangeText" Text="" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                               Margin="8,0,8,0" VerticalAlignment="Center" MinWidth="150" />
                    <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Click="Next_Click" ToolTip="下一时间段" />
                    <Button Content="今天" Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0"
                            Click="Today_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalAppsText" Text="总计 0 个" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Grid Width="210" Height="32">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="32"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索应用" FontSize="11"
                                   Foreground="#B0B2C0" Margin="11,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="10,8,10,8" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="12,4,12,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="应用" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="占该时段时长" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                        <Button x:Name="DurationSortButton" Grid.Column="3" Style="{StaticResource GhostButton}"
                                Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                FontSize="10.5" FontWeight="Normal" Foreground="{StaticResource MutedBrush}"
                                Click="DurationSort_Click" ToolTip="按总时长排序">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="时长" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="DurationSortGlyph" Text="↓" FontSize="10" Margin="3,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="AppListPanel" />
                    <TextBlock x:Name="EmptyText" Text="这个时间段还没有应用记录" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               Margin="0,40,0,44" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

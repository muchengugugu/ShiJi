<Window x:Class="ShiJi.Views.EditAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑应用" Width="440" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Icon="/Assets/app.ico">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <ContentControl x:Name="PreviewHost" Width="54" Height="54" />
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="PreviewName" Text="" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="自定义显示名称和图标底色" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="显示名称" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
            <TextBox x:Name="NameBox" Style="{StaticResource SearchBox}" Height="38" Margin="0,7,0,0"
                     MaxLength="40" TextChanged="NameBox_TextChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="图标底色" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
            <WrapPanel x:Name="ColorPanel" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="程序路径" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="11,9" Margin="0,7,0,0">
                <TextBlock x:Name="PathText" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="82" Padding="0,8"
                    Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="82" Padding="0,8" Margin="10,0,0,0"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>

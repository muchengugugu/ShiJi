<UserControl x:Class="ShiJi.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,30" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="常规" Style="{StaticResource CardTitle}" />
                    <Grid Height="46" Margin="0,8,0,0">
                        <TextBlock Text="开机自动启动" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Height="46">
                        <TextBlock Text="关闭窗口时最小化到托盘" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <CheckBox x:Name="TrayToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="显示" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="时长单位" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                    <Border Background="#F0F1F6" CornerRadius="10" Padding="3"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DurationAuto" Style="{StaticResource SegmentRadio}"
                                         GroupName="DurationMode" Content="自动（天 / 小时）"
                                         Checked="DurationMode_Checked" />
                            <RadioButton x:Name="DurationHours" Style="{StaticResource SegmentRadio}"
                                         GroupName="DurationMode" Content="小时"
                                         Checked="DurationMode_Checked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                <Grid>
                    <TextBlock Text="时间更新" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    <Border Background="#F0F1F6" CornerRadius="10" Padding="3"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DayStartZero" Style="{StaticResource SegmentRadio}"
                                         GroupName="DayStart" Content="零点"
                                         Checked="DayStart_Checked" />
                            <RadioButton x:Name="DayStartFour" Style="{StaticResource SegmentRadio}"
                                         GroupName="DayStart" Content="四点"
                                         Checked="DayStart_Checked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="数据" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <Button Content="打开数据文件夹" Style="{StaticResource SecondaryButton}" Padding="13,7"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenFolder_Click" />
                    </Grid>

                    <Border Background="#FAFAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="13,11" Margin="0,14,0,0">
                        <Grid>
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock x:Name="DataPathText" Text="" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                       TextWrapping="Wrap" Margin="23,0,0,0" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <TextBlock Text="导出记录" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Button Content="导出全部记录" Style="{StaticResource SecondaryButton}" Padding="13,7"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExportAll_Click" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,14,0,0" />
                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="清空统计" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Button Content="清空统计" Style="{StaticResource DangerButton}" Padding="13,7"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Clear_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/logo.png" Width="46" Height="46" />
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="时迹 1.0.0" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Windows 桌面版" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="打开日志" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="OpenLog_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

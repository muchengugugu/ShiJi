<UserControl x:Class="ShiJi.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShiJi.Controls"
             Background="Transparent">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,30">
            <Grid>
                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="SubTitleText" Text="看看今天把时间交给了哪些程序。" Margin="0,7,0,0"
                               Style="{StaticResource SubText}" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="12,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TodayText" Text="" FontSize="11.5" Margin="7,0,0,0"
                                       Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource GreenSoftBrush}" CornerRadius="20" Padding="11,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeaderStatusText" Text="监控中" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#0C9B6B" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,23,0,0">
                <Border Background="#F0F1F6" CornerRadius="10" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PeriodToday" Style="{StaticResource SegmentRadio}" GroupName="Period"
                                     Content="今日" Tag="today" IsChecked="True" Checked="Period_Checked" />
                        <RadioButton x:Name="PeriodWeek" Style="{StaticResource SegmentRadio}" GroupName="Period"
                                     Content="本周" Tag="week" Checked="Period_Checked" />
                        <RadioButton x:Name="PeriodMonth" Style="{StaticResource SegmentRadio}" GroupName="Period"
                                     Content="本月" Tag="month" Checked="Period_Checked" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PeriodRangeText" Text="" Style="{StaticResource MutedText}"
                           Margin="13,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Border x:Name="OnboardingBanner" Visibility="Collapsed" Background="#F3F0FF"
                    BorderBrush="#E6E0FF" BorderThickness="1" CornerRadius="14" Padding="17,14" Margin="0,17,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="先加入几个常用程序" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="名单里的程序只要在运行，就会自动记录时长和每天的启动情况。"
                                       FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="添加应用" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Padding="16,8" Click="AddFirst_Click" />
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,12,0,0">
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,6,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="总运行时长" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="TotalValue" Text="0秒" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TotalSub" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,6,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#E9F9F2" VerticalAlignment="Top">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="启动次数" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="LaunchValue" Text="0 次" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" />
                            <TextBlock x:Name="LaunchSub" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,6,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FFF5E6" VerticalAlignment="Top">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="#F39C33" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="最长使用" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="LongestValue" Text="—" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,7,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="LongestSub" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#EAF2FF" VerticalAlignment="Top">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="#4F7CFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="正在运行" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="RunningValue" Text="0 个" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" />
                            <TextBlock x:Name="RunningSub" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="374" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Style="{StaticResource Card}" Padding="21,18,18,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="ChartTitle" Text="每小时运行分布" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="ChartSubtitle" Text="今天 0–23 点，按应用叠加" Margin="0,4,0,0"
                                               Style="{StaticResource CaptionText}" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="ChartTotalText" Text="" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                            <controls:StackedBarChart x:Name="Chart" Height="242" Margin="0,12,0,0" />
                            <WrapPanel x:Name="ChartLegend" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="21,18,20,12" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="应用排行" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="RankingCountText" Text="" Style="{StaticResource CaptionText}"
                                               Margin="8,2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="按运行时长" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel x:Name="RankingPanel" Margin="0,4,0,0" />
                            <Border x:Name="RankingEmpty" Visibility="Collapsed" Padding="0,26,0,28">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                               Foreground="#D5D6E0" HorizontalAlignment="Center" />
                                    <TextBlock Text="这个时间段还没有运行记录" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="19,18,17,14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="今日启动" Style="{StaticResource CardTitle}" />
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="20" Padding="8,3"
                                            Margin="8,0,0,0">
                                        <TextBlock x:Name="LaunchRatioText" Text="0 / 0" FontSize="10.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="名单内的应用今天有没有启动过" Style="{StaticResource CaptionText}"
                                           Margin="0,5,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="LaunchAddButton" Content="&#xE710;" Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddFirst_Click"
                                    ToolTip="添加应用" />
                        </Grid>
                        <Grid>
                            <ScrollViewer x:Name="LaunchScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" MaxHeight="608">
                                <StackPanel x:Name="LaunchPanel" />
                            </ScrollViewer>
                            <Border x:Name="LaunchEmpty" Visibility="Collapsed" Padding="0,28,0,30">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="50" Height="50" CornerRadius="16" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="21"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="LaunchEmptyTitle" Text="名单还是空的" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,12,0,0" />
                                    <TextBlock x:Name="LaunchEmptySub" Text="添加程序后，这里会显示今天是否启动过。" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                    <Button x:Name="LaunchEmptyAddButton" Content="添加第一个应用" Style="{StaticResource PrimaryButton}" Padding="14,7"
                                            Margin="0,14,0,0" Click="AddFirst_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

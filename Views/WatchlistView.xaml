<UserControl x:Class="ShiJi.Views.WatchlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="34,26,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="应用名单" Style="{StaticResource PageTitle}" />
                <TextBlock Text="不看窗口焦点，只看进程是否存在。同时运行多个应用，会分别独立计时。"
                           Style="{StaticResource SubText}" Margin="0,7,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Click="AddRunning_Click" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="从运行中程序添加" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="AddApps_Click" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="添加应用" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F3F0FF" BorderBrush="#E7E1FF" BorderThickness="1" CornerRadius="11"
                Padding="13,10" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="计时规则：程序进程存在即计时；退出即结束；多个应用同时运行会并行累计。"
                               FontSize="11.5" Foreground="#5A4DC0" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" Text="" FontSize="11" Foreground="#7C70D8"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,15,0,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#FCFCFE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="White" BorderBrush="#E1E2EC" BorderThickness="1" CornerRadius="9"
                                    Width="248" Height="34">
                                <Grid>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                             Margin="30,0,10,0" VerticalContentAlignment="Center" FontSize="12"
                                             Foreground="{StaticResource TextBrush}" TextChanged="SearchBox_TextChanged"
                                             CaretBrush="{StaticResource AccentBrush}" />
                                    <TextBlock x:Name="SearchHint" Text="搜索应用名称或路径" FontSize="11.5"
                                               Foreground="#A6A8B7" Margin="31,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="FilterCountText" Text="" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="今日时长" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Width="92"
                                       TextAlignment="Right" />
                            <TextBlock Text="今日启动" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Width="80"
                                       TextAlignment="Center" />
                            <TextBlock Text="状态" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Width="88"
                                       TextAlignment="Center" />
                            <TextBlock Text="显示" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Width="58"
                                       TextAlignment="Center" />
                            <TextBlock Text="操作" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Width="72"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="AppList" Grid.Row="1" ItemContainerStyle="{StaticResource PlainListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F4F4F8" BorderThickness="0,0,0,1" Background="Transparent">
                                <Grid Height="66" Margin="18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="0,0,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="11" Background="{Binding BadgeBackground}"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <Border Background="#F3F3F8" CornerRadius="10" Padding="6,2" Margin="7,0,0,0"
                                                        Visibility="{Binding HiddenBadgeVisibility}">
                                                    <TextBlock Text="不显示" FontSize="8.5" Foreground="#8A8C9C" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PathText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding PathText}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding TodayDuration}" FontSize="11.5"
                                               Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding TodayLaunches}" FontSize="11.5"
                                               Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="3" Background="{Binding StatusBackground}" CornerRadius="20"
                                            Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" Fill="{Binding StatusDot}" VerticalAlignment="Center"
                                                     Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Medium"
                                                       Foreground="{Binding StatusForeground}" />
                                        </StackPanel>
                                    </Border>
                                    <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding Shown, Mode=OneTime}" Click="Toggle_Click"
                                              Tag="{Binding Id}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="是否显示在今日启动" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="&#xE70F;" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                FontSize="12" Click="Edit_Click" Tag="{Binding Id}"
                                                AutomationProperties.Name="重命名应用"
                                                ToolTip="重命名与颜色" />
                                        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                FontSize="12" Foreground="#B3B5C4" Click="Remove_Click" Tag="{Binding Id}"
                                                ToolTip="移出名单" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="EmptyState" Grid.Row="1" Background="White" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="20" Background="#F5F3FF">
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="27"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="名单还是空的" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   Margin="0,15,0,0" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptySub" Text="添加常用的程序，时迹会在后台记录它们的存在时长和每天的启动情况。"
                                   FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                        <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Center">
                            <Button Content="添加应用" Style="{StaticResource PrimaryButton}" Padding="16,8"
                                    Click="AddApps_Click" />
                            <Button Content="从运行中程序添加" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                    Margin="10,0,0,0" Click="AddRunning_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
